# Run python scripts/bootstrap.py to create .env with a private local operator token.
REEFTRACE_DATA_DIR=data/local
REEFTRACE_LOCAL_TOKEN=
REEFTRACE_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
REEFTRACE_CAMERA_STALE_S=2
REEFTRACE_CAMERA_SAMPLE_HZ=10

# Server only. Configuration readiness is not proof of an authenticated live call.
CHALK_ENABLED=false
CHALK_ROUTER_BASE_URL=https://api.chalk.ai/v1/router
CHALK_ROUTER_API_KEY=
CHALK_ENV_ID=
CHALK_MODEL=

# Enable only for your prepared, allowlisted direct iMessage conversation.
# One data directory per Photon project; persistent outbox cannot switch projects.
PHOTON_ENABLED=false
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_ROUTES_JSON=[]
# Route shape: [{"human_handle":"YOUR_HANDLE","agent_handle":"ASSIGNED_AGENT_HANDLE","role":"operator","allowed_cases":["actual-case-id"]}]
# xAI speech is explicit, server-side, and disabled until a key is configured.
GROK_VOICE_ENABLED=false
XAI_API_KEY=
