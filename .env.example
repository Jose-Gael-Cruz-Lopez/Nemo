# API
REEFTRACE_ENV=development
REEFTRACE_API_HOST=127.0.0.1
REEFTRACE_API_PORT=8000
REEFTRACE_DATABASE_URL=sqlite:///./reeftrace.db

# Optional hardware (leave disabled until hardware is tested)
REEFTRACE_SERIAL_PORT=
REEFTRACE_ENABLE_HARDWARE=false

# Sponsor adapters (server-side only; never expose these in the dashboard)
BUTTERBASE_API_URL=
BUTTERBASE_API_KEY=
CHALK_API_KEY=
PHOTON_API_KEY=
